{
  "expo": {
    "name": "Starenborg",
    "slug": "starenborg-mobilapp",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "se.starenborg.kundapp",
      "supportsTablet": false
    },
    "android": {
      "package": "se.starenborg.kundapp",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Starenborg behöver kameran för att du ska kunna fotografera dina kvitton.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
